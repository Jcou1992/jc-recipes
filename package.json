{
  "name": "jc-recipes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke --project='Desktop Chrome' --project='Auth (Desktop Chrome)'",
    "test:e2e:desktop": "playwright test --project='Desktop Chrome' --project='Auth (Desktop Chrome)'",
    "test:e2e:mobile": "playwright test --project='Mobile Safari' --project='Mobile Chrome' --project='Auth (Mobile Safari)'",
    "test:gate": "node scripts/test-gate.mjs",
    "test:gate:bootstrap": "node scripts/test-gate.mjs --bootstrap",
    "lint:hot": "node scripts/hot-token-lint.mjs",
    "seed:users": "node scripts/seed-users.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/postcss": "^4.2.2",
    "next": "^15.5.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.4",
    "@playwright/test": "^1.59.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "adm-zip": "^0.5.17",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.1",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "postcss": "^8",
    "typescript": "^6.0.2",
    "wrangler": "^4.85.0"
  }
}
